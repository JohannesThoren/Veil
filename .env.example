# Copy to .env (next to docker-compose.yml) and fill in. docker compose reads it automatically.

# Hostname clients use to reach the TURN server. Point a DNS A record at your public IP.
# Must not be proxied through Cloudflare (TURN is UDP/TCP, not HTTP).
TURN_DOMAIN=turn.example.com

# Your public IPv4. Behind a home router, add the server's LAN IP after a slash:
#   TURN_EXTERNAL_IP=203.0.113.7/192.168.1.10
# Find the public one with:  curl -4 ifconfig.me
TURN_EXTERNAL_IP=203.0.113.7/192.168.1.10

# Shared secret between Veil and coturn. Generate with:  openssl rand -hex 32
TURN_SECRET=change-me
