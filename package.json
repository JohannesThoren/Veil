{
  "name": "veil",
  "version": "0.1.0",
  "description": "End-to-end encrypted messenger with no usernames. Accounts are random IDs, contacts are added by ID or QR, devices are linked by code or QR.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node --no-warnings server/server.js",
    "dev": "npm run build && npm start",
    "test": "node --no-warnings test/crypto.test.js && node --no-warnings test/e2e.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "nanoid": "^5.1.16",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Johannes Thorén"
}
